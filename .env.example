# Offentlig adresse for siden (bruges i sitemap, canonical og JSON-LD)
NEXT_PUBLIC_SITE_URL=https://knudpedersen.dk

# Vis banneret "Forhåndsvisning" (sæt til "false" ved lancering)
NEXT_PUBLIC_PREVIEW_BANNER=true

# Booking- og kontaktformular: e-mails sendes via Resend, hvis nøglen er sat
RESEND_API_KEY=
BOOKING_TO_EMAIL=sktclemenstorv@knudpedersen.dk
BOOKING_FROM_EMAIL=booking@knudpedersen.dk

# Rolex-uret i headeren (nøgle fra Rolex)
NEXT_PUBLIC_ROLEX_CLOCK_API_KEY=

# Vis Rolex-priser, når hostingen ikke sender land (kun til lokal test)
ROLEX_PRICE_FALLBACK_SHOW=false
